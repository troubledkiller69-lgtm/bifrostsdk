# Windows-first repo: normalize text to CRLF on checkout, LF in the index.
* text=auto

*.ps1 text eol=crlf
*.py text eol=crlf
*.js text eol=crlf
*.jsx text eol=crlf
*.json text eol=crlf
*.md text eol=crlf
*.css text eol=crlf
*.html text eol=crlf
*.bat text eol=crlf
*.spec text eol=crlf

*.png binary
*.ico binary
*.bmp binary
*.exe binary
*.dll binary
*.sys binary
